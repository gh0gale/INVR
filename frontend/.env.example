# Supabase project. The anon key is designed to be public and is shipped in the
# client bundle; row-level security is what protects the data, not this key.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Backend origin. Read once in src/api.ts and used by every request.
VITE_API_BASE_URL="http://localhost:8000"

# This site's own origin, no trailing slash. Used only in index.html, for the
# absolute og:image / og:url link-preview tags. Set it as a Cloudflare *build*
# variable, e.g. https://invr.<your-subdomain>.workers.dev
VITE_SITE_URL="http://localhost:5173"
