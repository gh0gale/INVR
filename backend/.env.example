# Supabase project credentials. The service role key bypasses row-level
# security and must never reach the browser or a client-side bundle.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Market suffix appended to bare tickers. NSE equities by default.
MARKET_SUFFIX=".NS"

# Tutor intent router. Below this cosine similarity a question falls back to
# the general path instead of a specialised one.
ROUTER_CONFIDENCE_THRESHOLD="0.45"

# "enforce" applies the confidence threshold; "log_only" records the decision
# but keeps the best-matching route.
ROUTER_MODE="enforce"

# "block" refuses flagged input, and refuses when the classifier is unreachable.
# "log_only" records and admits. Use "block" anywhere real users can reach.
GUARDRAIL_MODE="block"

# OpenTelemetry collector (Arize Phoenix, Jaeger). Optional: spans are dropped
# with a warning if nothing is listening.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:6060/v1/traces"

# Only used by test_pipeline.py, the live end-to-end harness.
TEST_USER_EMAIL=""
TEST_USER_PASSWORD=""
